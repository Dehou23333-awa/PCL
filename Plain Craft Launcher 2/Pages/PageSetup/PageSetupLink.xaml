<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d" x:Class="PageSetupLink"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard x:Name="CardArgument" Margin="0,15" Title="连接选项">
                <StackPanel Margin="25,40,25,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Text="模式" Margin="0,0,25,0" />
                        <local:MyComboBox Grid.Row="0" x:Name="ComboLatencyMode" Grid.ColumnSpan="2" local:SettingService.Key="LinkLatencyMode" Grid.Column="1">
                            <local:MyComboBoxItem Content="优先直连" IsSelected="True" ToolTip="尽量不进行中转，而是 P2P 直连。" />
                            <local:MyComboBoxItem Content="优先低延迟" ToolTip="如果使用中转节点能降低延迟，就不进行直连。&#xa;这会让联机节点承担更多转发流量。" />
                        </local:MyComboBox>
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="联机节点">
                <StackPanel Margin="25,40,25,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="节点地址" Margin="0,0,25,0" />
                        <local:MyTextBox x:Name="TextCustomPeer" local:SettingService.Key="LinkCustomPeer" Grid.Column="1" MaxHeight="28" HintText="tcp://1.2.3.4:11010"
                            ToolTip="联机需要一个自己与朋友都能连到的 EasyTier 节点，填在这里。&#xa;多台设备如果在同一个局域网内，直接在游戏里联机即可，不需要本功能。&#xa;&#xa;多个节点使用英文逗号分隔，例如：&#xa;tcp://1.2.3.4:11010,tcp://user:pass@5.6.7.8:11010&#xa;&#xa;节点需要自行搭建，不会自动下载或使用公共节点。" />
                    </Grid>
                    <TextBlock Margin="0,12,0,0" FontSize="13" LineHeight="19" TextWrapping="Wrap" Foreground="{StaticResource ColorBrushGray3}"
                        Text="联机通过 EasyTier 将远程玩家组成一个虚拟局域网，因此必须有一个双方都能连到的节点。节点由使用者自行搭建，PCL 不提供公共节点；没有填写节点时无法创建房间。" />
                    <local:MyButton MinWidth="140" Padding="13,5" Margin="0,12,0,0" HorizontalAlignment="Left"
                        Text="如何搭建节点"
                        local:CustomEventService.EventType="打开网页" local:CustomEventService.EventData="https://easytier.cn" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
